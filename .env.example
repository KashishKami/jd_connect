# JD Connect — Frontend & SSR Application Environment Variables
# Copy this file to create your own local app secrets:
#   cp .env.example .env

# Self-Hosted Supabase Endpoint (Kong API gateway port)
SUPABASE_URL=http://localhost:19000
VITE_SUPABASE_URL=http://localhost:19000

# Publishable / Anon Key (generated from your self-hosted setup)
SUPABASE_PUBLISHABLE_KEY=YOUR_SELF_HOSTED_ANON_KEY_HERE
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SELF_HOSTED_ANON_KEY_HERE

# Service Role Key — Used server-side only for admin operations.
# WARNING: Never expose this key in public client-side code!
SUPABASE_SERVICE_ROLE_KEY=YOUR_SELF_HOSTED_SERVICE_ROLE_KEY_HERE


