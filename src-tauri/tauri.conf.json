{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "JD Connect",
  "version": "1.0.2",
  "identifier": "in.jdconnect.desktop",
  "build": {
    "frontendDist": "https://jdconnect.in",
    "devUrl": "https://jdconnect.in",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "title": "JD Connect",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/KashishKami/jd_connect/releases/latest/download/latest.json"
      ],
      "dialog": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ5NTIyQjMzNzZEQUU4NzEKUldSeDZOcDJNeXRTU2E0UmtKaTZtQXc5OEtYclM1d0hQUEZsYlNMUlEwZlhzZnNpaHdxSjZDdFAK"
    }
  }
}