# ==============================================================================
# JD Connect — Self-Hosted Supabase Environment Configuration
# ==============================================================================
#
# INSTRUCTIONS:
#   1. Copy this file to create your own local secrets file:
#      cp .env.example .env
#
#   2. Run this command in your PowerShell terminal to generate all secure
#      passwords, JWT secrets, and signed API keys:
#
# node -e "const crypto = require('crypto'); const gen = (len) => crypto.randomBytes(len).toString('base64').replace(/=/g, '').replace(/\+/g, '-').replace(/\//g, '_'); const pg = gen(20); const jwt = gen(64); const db = gen(12); const b64 = (buf) => buf.toString('base64').replace(/=/g, '').replace(/\+/g, '-').replace(/\//g, '_'); const sign = (p, s) => { const h = b64(Buffer.from(JSON.stringify({ alg: 'HS256', typ: 'JWT' }))); const d = h + '.' + b64(Buffer.from(JSON.stringify(p))); const sig = b64(crypto.createHmac('sha256', s).update(d).digest()); return d + '.' + sig; }; const iat = Math.floor(Date.now() / 1000); const exp = iat + 315360000; const anon = sign({ role: 'anon', iss: 'supabase', iat, exp }, jwt); const service = sign({ role: 'service_role', iss: 'supabase', iat, exp }, jwt); console.log('=================================================================='); console.log('COPY AND PASTE THESE VALUES INTO YOUR .env FILE:'); console.log('==================================================================\n'); console.log('POSTGRES_PASSWORD=' + pg); console.log('JWT_SECRET=' + jwt); console.log('ANON_KEY=' + anon); console.log('SERVICE_ROLE_KEY=' + service); console.log('DASHBOARD_PASSWORD=' + db); console.log('SECRET_KEY_BASE=' + gen(64)); console.log('VAULT_ENC_KEY=' + gen(24).substring(0, 32)); console.log('PG_META_CRYPTO_KEY=' + gen(32)); console.log('\n==================================================================');"
#
# ==============================================================================

COMPOSE_FILE=docker-compose.yml

############################################################
# Postgres Database & Auth secrets
############################################################
POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432
POSTGRES_PASSWORD=YOUR_GENERATED_POSTGRES_PASSWORD

JWT_SECRET=YOUR_GENERATED_JWT_SECRET
ANON_KEY=YOUR_GENERATED_ANON_KEY
SERVICE_ROLE_KEY=YOUR_GENERATED_SERVICE_ROLE_KEY

# Opaque API keys (leave blank or fill if using custom authentication gateways)
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
JWT_KEYS=
JWT_JWKS=

# Encryption keys (automatically generated by the node command above)
SECRET_KEY_BASE=YOUR_GENERATED_SECRET_KEY_BASE
VAULT_ENC_KEY=YOUR_GENERATED_VAULT_ENC_KEY
PG_META_CRYPTO_KEY=YOUR_GENERATED_PG_META_CRYPTO_KEY

# Pooler default values
POOLER_PROXY_PORT_TRANSACTION=6543
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
POOLER_TENANT_ID=jd-connect
POOLER_DB_POOL_SIZE=5

############################################################
# API Gateway & Ports (Custom Ports for JD Connect)
############################################################
KONG_HTTP_PORT=19000
KONG_HTTPS_PORT=19443
SUPABASE_PUBLIC_URL=http://localhost:19000

############################################################
# Studio (Admin UI dashboard)
############################################################
STUDIO_DEFAULT_ORGANIZATION=JD Connect
STUDIO_DEFAULT_PROJECT=jd-connect
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=YOUR_GENERATED_DASHBOARD_PASSWORD

# OpenAI key to enable AI features inside local Supabase Studio
OPENAI_API_KEY=

############################################################
# Auth & Mailer Settings (GoTrue)
############################################################
SITE_URL=http://localhost:19003
ADDITIONAL_REDIRECT_URLS=http://localhost:19003/**
API_EXTERNAL_URL=http://localhost:19000

JWT_EXPIRY=3600
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false

# SMTP Server details (configured for Option A Gmail App Passwords by default)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_SENDER_NAME=JD Connect
MAILER_SECURE_EMAIL_CHANGE_ENABLED=true

MAILER_URLPATHS_CONFIRMATION="/auth/v1/verify"
MAILER_URLPATHS_INVITE="/auth/v1/verify"
MAILER_URLPATHS_RECOVERY="/auth/v1/verify"
MAILER_URLPATHS_EMAIL_CHANGE="/auth/v1/verify"

ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false
ENABLE_ANONYMOUS_USERS=false

############################################################
# Storage
############################################################
STORAGE_BACKEND=file
STORAGE_FILE_SIZE_LIMIT=52428800
GLOBAL_S3_BUCKET=jd-connect
REGION=local

# S3 protocol credentials (local mock)
S3_PROTOCOL_ACCESS_KEY_ID=jdconnectlocalid
S3_PROTOCOL_ACCESS_KEY_SECRET=jdconnectlocalsecretkey

############################################################
# Logging & Analytics (Disabled locally to save RAM/CPU)
############################################################
LOGFLARE_PUBLIC_ACCESS_TOKEN=jdconnectlogflarepublictoken
LOGFLARE_PRIVATE_ACCESS_TOKEN=jdconnectlogflareprivatetoken
ANALYTICS_ENABLED=false


############################################################
# Internal Supabase Defaults (Required by compose file)
############################################################
SMTP_ADMIN_EMAIL=admin@example.com
PGRST_DB_SCHEMAS=public,storage,graphql_public
IMGPROXY_AUTO_WEBP=true
FUNCTIONS_VERIFY_JWT=false
STORAGE_TENANT_ID=jd-connect
